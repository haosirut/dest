[Unit]
Description=SOTY P2P Storage Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=soty
Group=soty
ExecStart=/usr/local/bin/sotyd daemon --data-dir /var/lib/soty
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/soty
PrivateTmp=true

# Sandboxing
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
CapabilityBoundingSet=
MemoryMax=2G
CPUQuota=50%

[Install]
WantedBy=multi-user.target

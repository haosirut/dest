{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Соты",
  "version": "0.1.0",
  "identifier": "com.soty.p2p",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Соты — P2P Хранилище",
        "label": "main",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": true,
        "focus": true,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: wss: asset: https://asset.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/**", "$DOWNLOAD/**", "$HOME/.soty/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "msi", "deb", "dmg", "appimage", "nsis", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "2024 Соты P2P",
    "category": "Utility",
    "shortDescription": "P2P децентрализованное хранилище",
    "longDescription": "Соты — децентрализованное P2P хранилище с клиентским шифрованием",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": { "language": ["ru-RU"] }
    }
  },
  "plugins": {
    "store": { "path": "soty_store.bin" },
    "updater": {
      "active": true,
      "dialog": true,
      "endpoint": "https://github.com/haosirut/dest/releases/latest/download/latest.json",
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5MUYyQTE0QTFENzc5QUUKUldTdWVkZWhGQ29mK1JIanhrM1FLaG5YNmE0azNWeXcvc0MvcEF0OUY0UE5za1gxREV4M21yVFEK"
    }
  }
}
